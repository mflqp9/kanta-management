# اس فائل کو کاپی کر کے .env.local بنائیں اور اپنی قیمتیں لکھیں
# Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# پرانے پروجیکٹ میں publishable key نہ ہو تو anon key بھی چلے گی:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# واحد ایڈمن کی ای میل — وہی جو supabase/schema.sql کے is_admin() میں لکھی ہے
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
# (اختیاری) ہیڈر میں ای میل کے ساتھ دکھایا جانے والا نام — خالی ہو تو "ایڈمن"
NEXT_PUBLIC_ADMIN_NAME=

# پرچی اور ہیڈر پر کاروبار کی معلومات
NEXT_PUBLIC_BUSINESS_NAME=کانٹا کھاتہ
NEXT_PUBLIC_BUSINESS_ADDRESS=لیاقت پور، ضلع رحیم یار خان
NEXT_PUBLIC_BUSINESS_PHONE=
# پروپرائٹر (مالک) کا نام — مرکزی صفحے پر دکھایا جاتا ہے
NEXT_PUBLIC_BUSINESS_OWNER=
